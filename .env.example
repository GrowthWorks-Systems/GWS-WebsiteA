# GWS Website - Environment Variables

# Password for accessing the internal preview
# Set this in Vercel dashboard under Project Settings > Environment Variables
# The password will be required to access the deployed site
VITE_GWS_ACCESS_PASSWORD=your_secure_password_here

# 21st.dev MCP Server API Key
# Get your key from: https://21st.dev/account/api-keys
# Set this in Vercel dashboard or .env.local for local development
VITE_21ST_API_KEY=your_21st_api_key_here

# Umami Analytics (optional)
# VITE_ANALYTICS_ENDPOINT=https://analytics.example.com
# VITE_ANALYTICS_WEBSITE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ───────────────────────────────────────────────────────────
# Contact Form — Mavis Webhook Integration
# ───────────────────────────────────────────────────────────
# These server-side environment variables power POST /api/contact.
# They must be set on the deployment platform (e.g. Vercel, Render,
# or the host running your Express server). They are NOT exposed
# to the client bundle.
#
# MAVIS_CONTACT_WEBHOOK_URL — The Mavis webhook endpoint that
#   receives contact form submissions.
# MAVIS_CONTACT_WEBHOOK_TOKEN — Bearer token for authenticating
#   to the Mavis webhook.
MAVIS_CONTACT_WEBHOOK_URL=your_mavis_webhook_url_here
MAVIS_CONTACT_WEBHOOK_TOKEN=your_mavis_webhook_token_here
